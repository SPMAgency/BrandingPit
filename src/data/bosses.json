{
  "_about": "Boss pool. Owner: Role Building. Every third battle a boss replaces the Raid; it fights your whole board alone. Afterwards every unit is fully healed and the round's ghost fight follows as normal (that fight counts toward 12 wins). Rules and loot boosts are from the design doc; every boss and number is PROPOSED, first-guess HP aimed at a 20-30 s fight, to be tuned in the fight sim. Bosses are two-legged on the shared rig, drawn larger, with their own clip set (animation plan). Boss looks follow the base line plus a boss line Character Dev writes with the first boss: bigger build, larger cell, one class signal exaggerated, no wings.",
  "schema": 1,
  "status": "DRAFT",
  "rules": {
    "levels": [
      3,
      6,
      9,
      12,
      13
    ],
    "level_13_requires": "perfect_12_0_run",
    "replaces_raid": true,
    "full_heal_after": true,
    "pool_pick": "random_from_level_pool",
    "source": "design",
    "on_win": {
      "relic_offer": true,
      "apparel_piece": 1,
      "commander_attribute_switch": true,
      "bonus_stat_for_chosen_attribute": {
        "choices": {
          "hp": 0.06,
          "atk": 0.06,
          "as": 0.06
        },
        "applies_to": "units_of_the_commander_attribute_class",
        "stacks": true,
        "source": "PROPOSED"
      }
    },
    "on_loss": {
      "lose_fraction_of_current_hp": 0.5,
      "loot": false,
      "bench_wiped": true,
      "source": "design"
    },
    "abilities_use": "cooldown_seconds",
    "cc_duration_mult_on_boss": 0.5,
    "enrage": {
      "after_s": 45,
      "damage_mult": 1.5
    },
    "proposed_fields": [
      "abilities_use",
      "cc_duration_mult_on_boss",
      "enrage",
      "on_win.bonus_stat_for_chosen_attribute"
    ],
    "note": "Bosses take half-length stuns and roots (not immunity, so the design's 'no immunity window' still holds), otherwise a Gusting Shallow board could lock a boss forever. Enrage stops a stalled fight running on."
  },
  "loot_boost_by_level": {
    "source": "design",
    "3": {
      "rare": 0.75
    },
    "6": {
      "epic": 0.75
    },
    "9": {
      "legendary": 0.25
    },
    "12": {
      "epic": 0.75,
      "legendary": 0.75
    },
    "13": {
      "special": {
        "chance": 0.75,
        "drops": [
          "legendary_relic",
          "legendary_magic_attack"
        ]
      }
    }
  },
